# Auto detect text files and perform LF normalization
* text=auto
# 1. Auto-detect text files and normalize line endings
* text=auto

# 2. Force Python and Markdown files to use standard line endings (fixes Windows/Mac conflicts)
*.py text eol=lf
*.md text eol=lf
*.ipynb text eol=lf

# 3. Git LFS (Large File Storage) for AI Models and Videos
# This prevents GitHub from blocking your push due to large file sizes!
*.pt filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text

# 4. Handle generated PDFs or images
*.pdf filter=lfs diff=lfs merge=lfs -text
*.jpg binary
*.png binary
